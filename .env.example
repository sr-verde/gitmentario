# Copy to `.env` and adjust. Values here override the defaults in compose.yml.

# --- Required ---
FORGE__BASE_URL="https://gitlab.example.com"
FORGE__PROJECT_ID=42
FORGE__AUTH_TOKEN="glpat-<secret>"

# --- Optional (defaults shown) ---
#GITMENTARIO_PORT=8000
#CONTENT_DIR=content
#COMMENTS_DIR=comments
#GIT_PUSH=false
#TARGET_BRANCH=main

# Origins of the site(s) that submit comments. Without this, browsers refuse
# the cross-origin request. Comma-separated, no trailing slash.
#ALLOWED_ORIGINS=https://example.com,https://www.example.com
#LOG_LEVEL=INFO
#FORGE__TYPE=gitlab
